<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Production Stop Tree View -->
    <record id="view_production_stop_tree" model="ir.ui.view">
        <field name="name">production.stop.tree</field>
        <field name="model">production.stop</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'scheduled'" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="equipment_id"/>
                <field name="production_team_id"/>
                <field name="reason"/>
                <field name="duration"/>
                <field name="actual_duration"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Production Stop Form View -->
    <record id="view_production_stop_form" model="ir.ui.view">
        <field name="name">production.stop.form</field>
        <field name="model">production.stop</field>
        <field name="arch" type="xml">
            <form string="Arrêt de Production">
                <header>
                    <button name="action_schedule" string="Programmer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Démarrer" type="object" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_done" string="Terminer" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="production_team_id"/>
                            <field name="maintenance_request_id"/>
                            <field name="production_order_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="duration"/>
                            <field name="reason"/>
                            <field name="impact_production"/>
                        </group>
                    </group>
                    <group string="Réalisations" invisible="state in ('draft', 'scheduled')">
                        <group>
                            <field name="actual_start_date" readonly="1"/>
                            <field name="actual_end_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="actual_duration" readonly="1"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <field name="reason_description" placeholder="Description détaillée du motif..."/>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Production Stop Search View -->
    <record id="view_production_stop_search" model="ir.ui.view">
        <field name="name">production.stop.search</field>
        <field name="model">production.stop</field>
        <field name="arch" type="xml">
            <search string="Rechercher Arrêts">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="reason"/>
                <filter string="Programmés" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Terminés" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('reason', '=', 'maintenance')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Équipement" name="group_by_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Motif" name="group_by_reason" context="{'group_by': 'reason'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'scheduled_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Production Stop Action -->
    <record id="action_production_stop" model="ir.actions.act_window">
        <field name="name">Arrêts de Production</field>
        <field name="res_model">production.stop</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_production_stop_search"/>
    </record>
</odoo>
