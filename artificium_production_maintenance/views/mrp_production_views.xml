<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Manufacturing Order Form View -->
    <record id="mrp_production_form_view_inherit_maintenance" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.maintenance</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_maintenances" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not maintenance_request_ids">
                    <field name="pending_maintenance" widget="statinfo" string="Maintenances"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group_extra_info']" position="inside">
                <field name="next_maintenance_date" readonly="1"/>
                <field name="pending_maintenance" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert" invisible="not pending_maintenance">
                    <strong>Maintenance en attente sur cet equipement.</strong>
                    Prochaine maintenance: <field name="next_maintenance_date"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
